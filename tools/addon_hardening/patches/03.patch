+
+bool WeaponNetworkBridge::make_local_handshake(wpn::protocol::CompatibilityHandshake &r_handshake) {
+	std::uint64_t fingerprint = 0;
+	if (role == ROLE_SERVER) {
+		WeaponAuthority *authority = resolve_weapon_authority();
+		if (authority == nullptr || !authority->is_ready()) return false;
+		fingerprint = std::uint64_t(authority->content_fingerprint());
+	} else {
+		if (compatibility_catalog.is_null() || !compatibility_catalog->is_sealed()) return false;
+		fingerprint = std::uint64_t(compatibility_catalog->fingerprint());
+	}
+	r_handshake.protocol_version = wpn::PROTOCOL_VERSION;
+	r_handshake.manifest = wpn::compatibility_manifest(fingerprint);
+	return true;
+}
+
+bool WeaponNetworkBridge::peer_has_session(int p_peer) const {
+	const auto session = peer_sessions.find(p_peer);
+	const auto epoch = peer_epochs.find(p_peer);
+	return role == ROLE_SERVER && p_peer > 0 && ownership && session != peer_sessions.end() &&
+		epoch != peer_epochs.end() && ownership->validate_session(p_peer, session->second).ok() &&
+		ownership->validate_connection_epoch(p_peer, epoch->second).ok();
+}
+
+bool WeaponNetworkBridge::peer_can_receive(int p_peer, const String &p_instance_id) const {
+	const auto grants = peer_instances.find(p_peer);
+	return peer_has_session(p_peer) && ownership->is_compatibility_ready(p_peer) &&
+		grants != peer_instances.end() && grants->second.count(p_instance_id) &&
+		ownership->validate_binding(p_peer, to_std(p_instance_id), wpn::protocol::WeaponRole::OBSERVER).ok();
+}
+
+bool WeaponNetworkBridge::expected_server() const {
+	const Ref<MultiplayerAPI> api = get_multiplayer();
+	return role == ROLE_CLIENT && api.is_valid() && api->get_remote_sender_id() == server_peer_id;
+}
+
+bool WeaponNetworkBridge::client_can_command(const String &p_instance_id) const {
+	return compatibility_confirmed && replica && replica->find(to_std(p_instance_id)) != nullptr &&
+		!replica->needs_resync(to_std(p_instance_id));
+}
+
+String WeaponNetworkBridge::scoped_command_id(int p_peer, const String &p_instance_id, const String &p_command_id) const {
+	if (!peer_has_session(p_peer) || command_namespace.is_empty()) return String();
+	// Length-framed strings plus trusted authority/session/connection identity.
+	// Hashing bounds the core identifier, it is not client authentication.
+	const String material = command_namespace + ":" + String::num_int64(authority_scope.length()) + ":" + authority_scope + ":" +
+		String::num_int64(authority_epoch) + ":" + String::num_int64(p_peer) + ":" +
+		String::num_int64(int64_t(peer_sessions.at(p_peer))) + ":" + String::num_int64(int64_t(peer_epochs.at(p_peer))) + ":" +
+		String::num_int64(p_instance_id.length()) + ":" + p_instance_id + ":" + p_command_id;
+	return "net_" + material.sha256_text();
+}
+
+Dictionary WeaponNetworkBridge::peer_diagnostics(int p_peer, const String &p_instance_id) const {
+	Dictionary out;
+	out["session_ready"] = peer_has_session(p_peer);
+	out["compatibility_ready"] = peer_has_session(p_peer) && ownership->is_compatibility_ready(p_peer);
+	out["recipient_granted"] = peer_can_receive(p_peer, p_instance_id);
+	out["acknowledged_revision"] = int64_t(acks ? acks->acknowledged_revision(p_peer, to_std(p_instance_id)) : 0);
+	out["baseline_acknowledged"] = sent_baselines.has_acknowledgement(p_peer, to_std(p_instance_id));
+	out["tracked_sent_baselines"] = int64_t(sent_baselines.size());
+	return out;
 }
 
