[node name="Checkpoint" type="Marker2D" parent="DistrictMarkers" unique_id=4748]
position = Vector2(470, 710)
metadata/title = "01 / WEST CHECKPOINT"
metadata/description = "Search booths, stalled convoy, armoured gate. The central road is exposed."

[node name="Customs" type="Marker2D" parent="DistrictMarkers" unique_id=4749]
position = Vector2(490, 466)
metadata/title = "02 / CUSTOMS RECORDS"
metadata/description = "Records rooms and dispatch desk. Three entrances connect the rail path and checkpoint."

[node name="Rail" type="Marker2D" parent="DistrictMarkers" unique_id=4750]
position = Vector2(1352, 288)
metadata/title = "03 / NORTH RAIL SIDINGS"
metadata/description = "Three sidings and cargo gaps. A long sightline competes with the outer treeline."

[node name="Freight" type="Marker2D" parent="DistrictMarkers" unique_id=4751]
position = Vector2(1288, 638)
metadata/title = "04 / FREIGHT COMPLEX"
metadata/description = "Through-warehouse circulation, independent inspection bay, two receiving sheds."

[node name="Power" type="Marker2D" parent="DistrictMarkers" unique_id=4752]
position = Vector2(2250, 556)
metadata/title = "05 / FUEL + SUBSTATION"
metadata/description = "Tank pockets, switchgear and control room. Barrel aisles break up the industrial apron."

[node name="Quarters" type="Marker2D" parent="DistrictMarkers" unique_id=4753]
position = Vector2(474, 1320)
metadata/title = "06 / WORKERS QUARTERS"
metadata/description = "Two dormitories, a ration shop and a canteen. Courtyards and alleys connect the southern bypass."

[node name="Clinic" type="Marker2D" parent="DistrictMarkers" unique_id=4754]
position = Vector2(1140, 1300)
metadata/title = "07 / EVACUATION CLINIC"
metadata/description = "Open triage yard and two clinic wings. Multiple doorways prevent a single-entry dead end."

[node name="Motor" type="Marker2D" parent="DistrictMarkers" unique_id=4755]
position = Vector2(2236, 1300)
metadata/title = "08 / MOTOR POOL"
metadata/description = "Repair bays, stalled vehicles and a parts yard. Wide garage entries connect both flanks."

[node name="Drain" type="Marker2D" parent="DistrictMarkers" unique_id=4756]
position = Vector2(1578, 1558)
metadata/title = "09 / DRAINAGE BYPASS"
metadata/description = "Two bridges over the drainage trench, a pump house and a service-exit approach."

