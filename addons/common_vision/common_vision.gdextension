[configuration]

entry_symbol = "common_vision_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

macos.debug = "res://addons/common_vision/bin/libcommon_vision.macos.template_debug.universal.dylib"
macos.release = "res://addons/common_vision/bin/libcommon_vision.macos.template_release.universal.dylib"
windows.debug.x86_64 = "res://addons/common_vision/bin/libcommon_vision.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/common_vision/bin/libcommon_vision.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/common_vision/bin/libcommon_vision.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/common_vision/bin/libcommon_vision.linux.template_release.x86_64.so"
android.debug.arm64 = "res://addons/common_vision/bin/libcommon_vision.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/common_vision/bin/libcommon_vision.android.template_release.arm64.so"
android.debug.x86_64 = "res://addons/common_vision/bin/libcommon_vision.android.template_debug.x86_64.so"
android.release.x86_64 = "res://addons/common_vision/bin/libcommon_vision.android.template_release.x86_64.so"
ios.debug = "res://addons/common_vision/bin/libcommon_vision.ios.template_debug.framework"
ios.release = "res://addons/common_vision/bin/libcommon_vision.ios.template_release.framework"
web.debug.wasm32 = "res://addons/common_vision/bin/libcommon_vision.web.template_debug.wasm32.wasm"
web.release.wasm32 = "res://addons/common_vision/bin/libcommon_vision.web.template_release.wasm32.wasm"
